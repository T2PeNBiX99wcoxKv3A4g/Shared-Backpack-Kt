{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Provides a Shared Backpack for all players.",
  "authors": [
    "170",
    "yukiyosanako"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.ykysnk.sharedBackpackKt.SharedBackpackKt"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "io.github.ykysnk.sharedBackpackKt.ModMenu"
      }
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "fzzy_config": "*"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  },
  "accessWidener": "${mod_id}.aw"
}
